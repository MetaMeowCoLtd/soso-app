# Copy to .env.local and fill in from your Supabase project (Settings -> API).
# Missing or wrong values here are not an error: the app falls back to a local
# demo mode automatically (see src/web/bootstrap.ts and src/web/demo-gateway.ts).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Generate a VAPID key pair with `npx web-push generate-vapid-keys --json`.
# This is the PUBLIC key only; never put the matching private key in this file.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
