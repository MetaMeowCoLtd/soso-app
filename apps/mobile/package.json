{
  "name": "soso-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Soso native app (Expo/React Native). Deliberately outside the root npm workspace — see the repo README's Monorepo structure section. Consumes packages/core via relative filesystem imports, not the soso-core package name.",
  "main": "index.ts",
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.3.10",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.22",
    "expo-linear-gradient": "^57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  }
}
